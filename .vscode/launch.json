{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug numc (example args)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/x64/Debug/numc.exe",
            "args": ["100", "75", "25", "10", "7", "5", "666"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "build debug (cl)"
        },
        {
            "name": "Debug numc (prompt for args)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/x64/Debug/numc.exe",
            "args": ["${input:numcArgs}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "build debug (cl)"
        }
    ],
    "inputs": [
        {
            "id": "numcArgs",
            "type": "promptString",
            "description": "Six numbers and a target, space-separated (e.g. 100 75 25 10 7 5 666)",
            "default": "100 75 25 10 7 5 666"
        }
    ]
}
